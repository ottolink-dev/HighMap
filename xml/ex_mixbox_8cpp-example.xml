<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">int</highlight><highlight class="normal"><sp/><ref refid="main_8cpp_1a3c04138a5bfe5d72780bb7e82a18e627" kindref="member">main</ref>(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal">)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="keyword">const</highlight><highlight class="normal"><sp/>glm::ivec2<sp/><ref refid="elevation__from__contours_8cpp_1af339e609a44f3516574ffecaf5245fa3" kindref="member">shape</ref><sp/>=<sp/>{512,<sp/>128};</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//<sp/>Define<sp/>two<sp/>classic<sp/>pigment<sp/>colors:<sp/>Ultramarine<sp/>Blue<sp/>and<sp/>Cadmium<sp/>Yellow</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//<sp/>Ultramarine<sp/>Blue:<sp/>RGB<sp/>(25,<sp/>0,<sp/>89)<sp/>-&gt;<sp/>normalized:<sp/>(0.098f,<sp/>0.0f,<sp/>0.349f)</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//<sp/>Cadmium<sp/>Yellow:<sp/>RGB<sp/>(254,<sp/>236,<sp/>0)<sp/>-&gt;<sp/>normalized:<sp/>(0.996f,<sp/>0.925f,<sp/>0.0f)</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="keyword">const</highlight><highlight class="normal"><sp/>glm::vec3<sp/>blue(0.098f,<sp/>0.0f,<sp/>0.349f);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="keyword">const</highlight><highlight class="normal"><sp/>glm::vec3<sp/>yellow(0.996f,<sp/>0.925f,<sp/>0.0f);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
